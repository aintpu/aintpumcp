{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntpu-aia-mcp-legacy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],

  // 原本的 ntpu-aia-mcp 名稱與 aia.mcp.ntpu.ai 網域已轉給 ntpu-ai-assistant 的新 MCP（mcp/）。
  // 本 Worker 改名為 ntpu-aia-mcp-legacy，僅以 workers.dev 網址提供。
  "workers_dev": true,

  "containers": [
    {
      "class_name": "NtpuAiaMcpBackend",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "NtpuAiaMcpBackend"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NtpuAiaMcpBackend"]
    }
  ],

  "observability": {
    "enabled": true
  }
}

